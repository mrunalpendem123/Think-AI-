{
    "manifest_version": 3,
    "name": "Think AI Co-worker",
    "version": "0.1.0",
    "description": "Local-first Agentic Cloud Co-worker powered by WebLLM",
    "side_panel": {
        "default_path": "index.html"
    },
    "permissions": [
        "sidePanel",
        "activeTab",
        "scripting",
        "storage",
        "tabs"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "content_security_policy": {
        "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
    },
    "web_accessible_resources": [
        {
            "resources": [
                "web-llm.js",
                "sw.js",
                "_next/*"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ],
    "background": {
        "service_worker": "sw.js",
        "type": "module"
    }
}